# TaskFlow environment variables
#
# Ye file sirf documentation ke liye hai — asli values Render ke dashboard me
# (ya taskflow-backend/.env me locally) daalo, .env kabhi commit mat karo.

# Port sirf local dev ke liye. Render par ye MAT set karo —
# Render khud random port assign karta hai aur `.env` ka 5001 use hoga.
PORT=5001

# Database connection string.
# Local me default MongoDB:
MONGODB_URL=mongodb://localhost:27017/taskflow

# MongoDB Atlas par dhyan do database NAAM zaroor ho, warna Mongoose silently
# `test` database use kar leta hai:
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/taskflow
#
# Atlas par ye do cheezein check karna mat bhoolna:
#   1. Network Access me 0.0.0.0/0 add karo. Render ke outbound IPs dynamic
#      hote hain aur kisi fixed range me nahi aate — iske bina connection
#      timeout hoke service "Exited with status 1" ho jati hai.
#   2. Database Access me user ko `taskflow` DB par read/write do.

# JWT signing secret — koi lamba random string.
JWT_SECRET=change_me_to_a_long_random_string

# Sirf tab chahiye jab frontend backend se alag origin par ho (local dev).
# Production me Render dono ek hi origin serve karta hai, isliye ye khali
# chhod do — warna CORS galat origin par set ho jayegi.
FRONTEND_URL=http://localhost:5173
