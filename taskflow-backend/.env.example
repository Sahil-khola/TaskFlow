
PORT=5001

MONGO_URL=mongodb://localhost:27017/taskflow

# JWT signing secret. Koi bhi lamba random string.
# Render par ye `generateValue: true` se khud generate hoga.
JWT_SECRET=change_me_to_a_long_random_string

# Sirf tab chahiye jab frontend backend se ALAG origin par ho (local dev).
# Production me Render dono ek hi origin serve karta hai — isko khali chhod do,
# warna CORS galat origin par set ho jayega.
FRONTEND_URL=http://localhost:5173
